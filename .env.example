# Supabase 접속 정보 예시 파일입니다.
# 이 파일을 복사해서 .env.local을 만들고, 실제 값을 넣어 주세요.
#   cp .env.example .env.local
# .env.local은 .gitignore에 들어 있어서 GitHub에 올라가지 않습니다.
#
# 값 찾는 곳: Supabase 대시보드 → 상단 Connect 버튼 (또는 Project Settings → API Keys)
# ⚠️ secret 키(sb_secret_..., service_role)는 절대 넣지 마세요. 공개 키(publishable / anon)만 씁니다.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
